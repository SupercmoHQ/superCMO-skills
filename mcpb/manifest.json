{
  "manifest_version": "0.3",
  "name": "supercmo",
  "display_name": "SuperCMO",
  "version": "0.1.9",
  "description": "Marketing media generation — image, video, voice — for AI agents. BYO keys.",
  "author": {
    "name": "SuperCMO",
    "url": "https://github.com/SupercmoHQ/superCMO-skills"
  },
  "homepage": "https://getsupercmo.ai",
  "documentation": "https://github.com/SupercmoHQ/superCMO-skills",
  "icon": "icon.png",
  "server": {
    "type": "binary",
    "entry_point": "uvx",
    "mcp_config": {
      "command": "uvx",
      "args": ["supercmo-skills@0.1.9"],
      "env": {
        "WAVESPEED_API_KEY": "${user_config.wavespeed_api_key}",
        "FAL_KEY": "${user_config.fal_key}",
        "ELEVENLABS_API_KEY": "${user_config.elevenlabs_api_key}",
        "GEMINI_API_KEY": "${user_config.gemini_api_key}",
        "FIRECRAWL_API_KEY": "${user_config.firecrawl_api_key}"
      }
    }
  },
  "user_config": {
    "wavespeed_api_key": {
      "type": "string",
      "title": "WAVESPEED_API_KEY",
      "description": "WaveSpeed key — image + video (recommended)",
      "sensitive": true,
      "required": false
    },
    "fal_key": {
      "type": "string",
      "title": "FAL_KEY",
      "description": "fal.ai key — image + video",
      "sensitive": true,
      "required": false
    },
    "elevenlabs_api_key": {
      "type": "string",
      "title": "ELEVENLABS_API_KEY",
      "description": "ElevenLabs key — voiceover",
      "sensitive": true,
      "required": false
    },
    "gemini_api_key": {
      "type": "string",
      "title": "GEMINI_API_KEY",
      "description": "Gemini key — image/video analysis",
      "sensitive": true,
      "required": false
    },
    "firecrawl_api_key": {
      "type": "string",
      "title": "FIRECRAWL_API_KEY",
      "description": "Firecrawl key — URL extraction",
      "sensitive": true,
      "required": false
    }
  },
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"]
  }
}
